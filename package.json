{
  "name": "income-navigator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "income-navigator": "src/cli/main.ts"
  },
  "scripts": {
    "cli": "tsx src/cli/main.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "quality": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/run-playwright-with-host-check.mjs",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:ci": "playwright test",
    "quality:full": "npm run quality && npm run test:coverage && npm run test:e2e"
  },
  "dependencies": {
    "@tailwindcss/postcss": "latest",
    "clsx": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "tailwind-merge": "latest",
    "tastytrade-ts-sdk": "file:vendor/tastytrade-ts-sdk-0.1.0.tgz"
  },
  "devDependencies": {
    "@eslint/eslintrc": "latest",
    "@playwright/test": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitest/coverage-v8": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "prettier": "latest",
    "tailwindcss": "latest",
    "tsx": "^4.21.0",
    "typescript": "latest",
    "vitest": "latest"
  },
  "overrides": {
    "postcss": "^8.5.14"
  }
}
